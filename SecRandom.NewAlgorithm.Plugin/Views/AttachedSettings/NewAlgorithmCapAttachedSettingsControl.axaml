<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sr="http://secrandom.sectl.cn/schemas/xaml/core"
             xmlns:local="clr-namespace:SecRandom.NewAlgorithm.Plugin.Views.AttachedSettings"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SecRandom.NewAlgorithm.Plugin.Views.AttachedSettings.NewAlgorithmCapAttachedSettingsControl"
             x:DataType="local:NewAlgorithmCapAttachedSettingsControl"
             x:Name="RootControl">
    <StackPanel Spacing="6"
                DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:NewAlgorithmCapAttachedSettingsControl}}">
        <sr:Field Label="个人抽取次数上限">
            <NumericUpDown Value="{Binding BaseCapValue, Mode=TwoWay}"
                           Minimum="1"
                           Maximum="1000"
                           Increment="1"
                           FormatString="0"
                           MinWidth="140" />
        </sr:Field>
        <TextBlock Text="抽中次数达到该值后不再进入候选池（相当于半重复阈值的逐人版本）；生效上限随「内幕设置」倍率同比例放大。纯次数阀门，不影响权重；未启用时无个人上限。仅对选用「份额欠账均衡」算法时的抽取生效"
                   TextWrapping="Wrap"
                   Opacity="0.6" />
    </StackPanel>
</UserControl>